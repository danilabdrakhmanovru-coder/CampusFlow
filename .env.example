# University server: supply independent random URL-safe secrets.
CAMPUSFLOW_DB_PASSWORD=
CAMPUSFLOW_JWT_SECRET=
CAMPUSFLOW_SCHEDULE_SECRET=
CAMPUSFLOW_PORT=8767

# Optional website metadata (defaults are set in Compose)
CAMPUSFLOW_SUPPORT_EMAIL=
CAMPUSFLOW_SUPPORT_HOURS=

# Draft privacy document metadata. Use a new version for each approved revision.
CAMPUSFLOW_PRIVACY_VERSION=
CAMPUSFLOW_PRIVACY_OPERATOR=
CAMPUSFLOW_PRIVACY_RESPONSIBLE=
CAMPUSFLOW_PRIVACY_CONTACT=
CAMPUSFLOW_PRIVACY_EFFECTIVE_DATE=

CAMPUSFLOW_TIMEZONE=Asia/Yekaterinburg
CAMPUSFLOW_INSTITUTE=Учебный кампус
CAMPUSFLOW_BOOKING_MODE=standalone
# Optional nine HH:MM-HH:MM intervals, separated by commas
CAMPUSFLOW_BELL=
# Demo on Windows uses host.docker.internal:11434 by default.
# For university deployment, point this to the local Ollama service.
CAMPUSFLOW_OLLAMA_URL=
CAMPUSFLOW_OLLAMA_MODEL=qwen2.5:7b
